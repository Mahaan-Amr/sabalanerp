+      AND COALESCE(i."exitedAt", 'infinity'::timestamp) > NEW."enteredAt"
+  ) THEN RAISE EXCEPTION 'attendance_interval_overlap' USING ERRCODE = '23514'; END IF;
+  RETURN NEW;
+END $$;
