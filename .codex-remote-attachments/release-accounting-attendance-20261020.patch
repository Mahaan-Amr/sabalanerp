+    if (userUpdate.count !== 1) throw new PersonnelIdentityError(409, 'PERSONNEL_IDENTITY_CONFLICT', 'حساب متصل هم‌زمان تغییر کرده است؛ آخرین اطلاعات را دریافت کنید.');
