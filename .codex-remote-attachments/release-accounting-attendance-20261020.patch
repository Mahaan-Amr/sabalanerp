@@ -0,0 +1,18 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { estimateScanClock, type ClockSample } from './clockEstimate';
+
+test('clock compensation keeps raw time intact and expires instead of rewriting historical evidence', () => {
+  const now = Date.parse('2026-10-17T07:00:00Z');
+  const raw = '2026-10-17T06:59:25Z';
+  const sample: ClockSample = { terminalId: 'test', evidence: { offsetMs: 35000, uncertaintyMs: 1050, measuredAt: new Date(now).toISOString() } };
+  assert.deepEqual(estimateScanClock(raw, sample, now), { at: '2026-10-17T07:00:00.000Z', uncertaintySeconds: '1.1' });
+  assert.equal(raw, '2026-10-17T06:59:25Z');
+  assert.equal(estimateScanClock(raw, { ...sample, evidence: { ...sample.evidence, uncertaintyMs: 15000 } }, now)?.uncertaintySeconds, '15.0');
+  assert.equal(estimateScanClock(raw, { ...sample, evidence: { ...sample.evidence, uncertaintyMs: 15001 } }, now), null);
+  assert.equal(estimateScanClock(raw, { ...sample, evidence: { ...sample.evidence, offsetMs: 300001 } }, now), null);
+  assert.equal(estimateScanClock(raw, sample, now + 121000), null);
+  assert.equal(estimateScanClock('2026-10-16T07:00:00Z', sample, now), null);
+  assert.equal(estimateScanClock(raw, undefined, now), null);
+  assert.equal(estimateScanClock(raw, { ...sample, evidence: { ...sample.evidence, measuredAt: 'invalid' } }, now), null);
+});
diff --git a/frontend/src/features/attendance-device/clockEstimate.ts b/frontend/src/features/attendance-device/clockEstimate.ts
new file mode 100644
index 00000000..e3e6ca1b
--- /dev/null
+++ b/frontend/src/features/attendance-device/clockEstimate.ts
@@ -0,0 +1,12 @@
+export type ClockSample = { terminalId: string; evidence: { offsetMs: number; uncertaintyMs: number; measuredAt: string } };
+
+// Estimates are intentionally separate from immutable source timestamps and
+// must not extrapolate a fresh clock reading over historical attendance.
+export function estimateScanClock(raw: string | null | undefined, sample?: ClockSample, now = Date.now()) {
+  if (!raw || !sample) return null;
+  const { offsetMs, uncertaintyMs, measuredAt } = sample.evidence;
+  const measured = Date.parse(measuredAt);
+  const corrected = Date.parse(raw) + offsetMs;
+  if (!Number.isFinite(corrected) || !Number.isFinite(measured) || !Number.isFinite(offsetMs) || !Number.isFinite(uncertaintyMs) || uncertaintyMs < 0 || uncertaintyMs > 15000 || Math.abs(offsetMs) > 300000 || Math.abs(now - measured) > 120000 || Math.abs(corrected - measured) > 120000) return null;
+  return { at: new Date(corrected).toISOString(), uncertaintySeconds: (uncertaintyMs / 1000).toFixed(1) };
+}
