+++ b/deploy/clamav/health.sh
@@ -0,0 +1,32 @@
+#!/bin/sh
+set -eu
+fail() { echo "ClamAV unhealthy: $*" >&2; exit 1; }
+run_dir="${CLAMAV_RUN_DIRECTORY:-/run/sabalan-clamav}"
+db_dir="${CLAMAV_DATABASE_DIRECTORY:-/var/lib/clamav}"
+interval="${CLAMAV_UPDATE_INTERVAL_SECONDS:-7200}"
+case "$interval" in ''|*[!0-9]*) fail 'invalid update interval';; esac
+[ "$interval" -ge 3600 ] && [ "$interval" -le 86400 ] || fail 'invalid update interval'
+for name in clamd updater; do
+  [ -f "$run_dir/$name.pid" ] || fail "$name PID is missing"
+  pid="$(cat "$run_dir/$name.pid")"
+  case "$pid" in ''|*[!0-9]*) fail "$name PID is invalid";; esac
+  kill -0 "$pid" 2>/dev/null || fail "$name stopped"
+  # kill -0 succeeds for zombies. Linux BusyBox ps does not support -p.
+  state="$(if [ -r "/proc/$pid/stat" ]; then sed 's/.*) //' "/proc/$pid/stat" | cut -d' ' -f1; else ps -o stat= -p "$pid" 2>/dev/null || true; fi)"
+  case "$state" in ''|*Z*) fail "$name is missing or defunct";; esac
+done
+[ -f "$db_dir/.sabalan-updater-state" ] || fail 'no verified update cycle'
+read -r attempted succeeded result next < "$db_dir/.sabalan-updater-state"
+for value in "$attempted" "$succeeded" "$result" "$next"; do
+  case "$value" in ''|*[!0-9]*) fail 'invalid persisted updater state';; esac
+done
+now="$(date +%s)"
+[ "$result" -eq 0 ] && [ "$succeeded" -gt 0 ] && [ "$succeeded" -ge "$attempted" ] || fail 'latest update failed or is incomplete'
+[ "$now" -ge "$succeeded" ] && [ "$((now - succeeded))" -le "$((interval * 2))" ] || fail 'successful update evidence is stale'
+log="$db_dir/.sabalan-freshclam-result"
+[ -f "$log" ] || fail 'no successful FreshClam result evidence'
+if grep -Eiq 'cool.down|rate.limit|blocked|ERROR:|HTTP[^0-9]*(429|403)' "$log"; then fail 'FreshClam reports cooldown or error'; fi
+for name in main daily bytecode; do
+  grep -Eq "(^|[[:space:]])$name[.](cvd|cld) (database is up-to-date|updated)" "$log" || fail "$name has no successful update evidence"
+done
+clamdscan --ping=1 >/dev/null 2>&1 || fail 'scanner is unavailable'
diff --git a/deploy/clamav/inspect-native.sh b/deploy/clamav/inspect-native.sh
new file mode 100644
index 00000000..18b61b72
--- /dev/null
+++ b/deploy/clamav/inspect-native.sh
@@ -0,0 +1,15 @@
+#!/bin/sh
+# Read-only evidence for the official legacy daemon layout. No update or mutation.
+set -eu
+printf 'CLOCK\t%s\t%s\t%s\t%s\t%s\n' "$(date +%s)" "$(cut -d' ' -f1 /proc/uptime)" "$(getconf CLK_TCK)" "$(id -u clamav)" "$(date +%z)"
+for entry in /proc/[0-9]*; do
+  name="$(cat "$entry/comm" 2>/dev/null || true)"
+  case "$name" in freshclam|clamd)
+    stat="$(sed 's/.*) //' "$entry/stat")"
+    state="$(printf '%s\n' "$stat" | awk '{print $1}')"
+    started="$(printf '%s\n' "$stat" | awk '{print $20}')"
+    uid="$(awk '/^Uid:/{print $2}' "$entry/status")"
+    arguments="$(base64 < "$entry/cmdline" | tr -d '\n')"
+    printf 'PROCESS\t%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "${entry##*/}" "$uid" "$state" "$started" "$arguments"
+  ;; esac
+done
diff --git a/deploy/clamav/update-once.sh b/deploy/clamav/update-once.sh
new file mode 100644
index 00000000..6e55f08c
--- /dev/null
+++ b/deploy/clamav/update-once.sh
@@ -0,0 +1,47 @@
+#!/bin/sh
+set -eu
+db_dir="${CLAMAV_DATABASE_DIRECTORY:-/var/lib/clamav}"
+interval="${CLAMAV_UPDATE_INTERVAL_SECONDS:-7200}"
+case "$interval" in ''|*[!0-9]*) exit 1;; esac
+[ "$interval" -ge 3600 ] && [ "$interval" -le 86400 ] || exit 1
+state="$db_dir/.sabalan-updater-state"
+# flock is held for the complete FreshClam invocation, never just state writes.
+exec 9>"$db_dir/.sabalan-updater.lock"
+flock -n 9 || exit 75
+attempted=0; succeeded=0; result=1; next=0
+if [ -f "$state" ]; then
+  read -r attempted succeeded result next < "$state"
+  for value in "$attempted" "$succeeded" "$result" "$next"; do
+    case "$value" in ''|*[!0-9]*) echo 'Invalid updater state; refusing to reset its schedule.' >&2; exit 1;; esac
+  done
+fi
+now="$(date +%s)"
+[ "$now" -ge "$next" ] || exit 0
+# Reserve the next slot before running. Recreate/crash must not force another download.
+next="$((now + interval))"
+umask 077
+printf '%s %s 1 %s\n' "$now" "$succeeded" "$next" > "$state.next"
+sync -f "$state.next"
+mv "$state.next" "$state"
+sync -f "$db_dir"
+result=0
+log="$db_dir/.sabalan-freshclam-result"
+freshclam --stdout --config-file=/etc/clamav/freshclam.conf --datadir="$db_dir" > "$log.next" 2>&1 || result=$?
+mv "$log.next" "$log"
+cat "$log"
+# FreshClam 1.4.6 can return zero while honoring a previous CDN cooldown.
+# Require explicit success for every official database, not just its exit status.
+if [ "$result" -eq 0 ]; then
+  if grep -Eiq 'cool.down|rate.limit|blocked|ERROR:|HTTP[^0-9]*(429|403)' "$log"; then result=17; fi
+  for name in main daily bytecode; do
+    if ! grep -Eq "(^|[[:space:]])$name[.](cvd|cld) (database is up-to-date|updated)" "$log"; then result=17; fi
+  done
+fi
+finished="$(date +%s)"
+if [ "$result" -eq 0 ]; then succeeded="$finished"; fi
+printf '%s %s %s %s\n' "$now" "$succeeded" "$result" "$next" > "$state.next"
+sync -f "$state.next"
+mv "$state.next" "$state"
+sync -f "$db_dir"
+[ "$result" -eq 0 ] || echo "FreshClam failed (exit $result); cooldown and next scheduled slot retained." >&2
+exit "$result"
