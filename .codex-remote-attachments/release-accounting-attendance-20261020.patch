+  assert.equal(await tx.attendanceIntervalAudit.count({where:{intervalId:f.first.id}}),0);
+  assert.equal((await tx.attendanceTerminal.findUniqueOrThrow({where:{id:f.terminal.id}})).mode,'SHADOW');
