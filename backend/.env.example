# Database
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/sabalanerp?schema=public"

# JWT
JWT_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

# Confidential Personnel performance payloads (exactly 32 bytes, base64 encoded)
PERSONNEL_PERFORMANCE_ENCRYPTION_KEY_ID="local-development-v1"
PERSONNEL_PERFORMANCE_ENCRYPTION_KEY_BASE64="REPLACE_WITH_32_BYTE_BASE64_KEY"
PERFORMANCE_PROMOTION_ATTESTATION_KEY_ID="REPLACE_WITH_VERSIONED_KEY_ID"
PERFORMANCE_PROMOTION_ATTESTATION_KEY_BASE64="REPLACE_WITH_AT_LEAST_32_BYTE_BASE64_KEY"
PERFORMANCE_RELEASE_COMMIT="REPLACE_WITH_40_CHARACTER_COMMIT"
PERFORMANCE_RELEASE_SOURCE_HASH="REPLACE_WITH_64_CHARACTER_SOURCE_HASH"
PERFORMANCE_RELEASE_SCHEMA_HASH="REPLACE_WITH_64_CHARACTER_SCHEMA_HASH"
PERFORMANCE_RELEASE_POLICY_HASH="REPLACE_WITH_64_CHARACTER_POLICY_HASH"
PERFORMANCE_RELEASE_INFRASTRUCTURE_HASH="REPLACE_WITH_64_CHARACTER_INFRASTRUCTURE_HASH"
PERFORMANCE_RELEASE_BACKEND_IMAGE="sha256:REPLACE_WITH_64_CHARACTER_DIGEST"
PERFORMANCE_RELEASE_FRONTEND_IMAGE="sha256:REPLACE_WITH_64_CHARACTER_DIGEST"
PERFORMANCE_RELEASE_INQUIRY_IMAGE="sha256:REPLACE_WITH_64_CHARACTER_DIGEST"
PERSONNEL_PERFORMANCE_EXPORT_ENCRYPTION_KEY_ID="local-export-v1"
PERSONNEL_PERFORMANCE_EXPORT_ENCRYPTION_KEY_BASE64="REPLACE_WITH_DISTINCT_32_BYTE_BASE64_KEY"
PERFORMANCE_ERASURE_BULK_THRESHOLD=REPLACE_WITH_APPROVED_POSITIVE_INTEGER

# Server
PORT=5000
NODE_ENV="production"

# CORS
FRONTEND_URL="https://erp.example.com"

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"

# SMS.ir Configuration
SMS_IR_API_KEY="CHANGE_ME"
SMS_IR_API_URL="https://api.sms.ir/v1"
SMS_IR_TEMPLATE_ID=135816
SMS_IR_CONTRACT_CONFIRM_TEMPLATE_ID=385075
SMS_IR_HIRING_INVITATION_TEMPLATE_ID=343660
SMS_IR_HIRING_INVITATION_TEMPLATE_PARAMETERS=CODE
SMS_IR_HIRING_CORRECTION_TEMPLATE_ID=763918
SMS_IR_HIRING_CORRECTION_TEMPLATE_PARAMETERS=DETAILS,CODE
SMS_IR_HIRING_OFFER_TEMPLATE_ID=894291
SMS_IR_HIRING_OFFER_TEMPLATE_PARAMETERS=CODE
SMS_IR_DISPATCH_CONFIRM_OTP_TEMPLATE_ID=173656
SMS_IR_DISPATCH_EXIT_TEMPLATE_ID=153829
SMS_IR_DISPATCH_EXIT_MANUAL_RETRY_TEMPLATE_ID=3429496
SMS_IR_ENVIRONMENT="production"

# HR hiring private documents (required in production unless explicitly overridden)
HR_HIRING_ANTIVIRUS_COMMAND="clamdscan"
ALLOW_UNSCANNED_HR_FILES="false"
PUBLIC_APP_URL="https://erp.example.com"

# Contract confirmation
CONTRACT_CONFIRM_LINK_TTL_DAYS=60
CONTRACT_CONFIRM_OTP_TTL_MINUTES=10
CONTRACT_CONFIRM_MAX_ATTEMPTS=5
CONTRACT_CONFIRM_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_CODE_EXPIRY_MINUTES=10
