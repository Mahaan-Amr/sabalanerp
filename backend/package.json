    "test:product-graph-persistence": "tsx src/services/__tests__/contractProductGraphPersistence.test.ts",
    "test:product-graph-migration": "tsx src/services/__tests__/contractProductGraphMigration.test.ts && tsx src/services/__tests__/contractOperationIdentityRepair.test.ts",
    "test:contract-edit-session": "tsx src/services/__tests__/contractEditSessionService.test.ts",
    "test:seller-product-history": "tsx src/services/__tests__/sellerProductHistory.test.ts",
    "migration:product-graph:dry": "node dist/scripts/dry-run-contract-product-graph-migration.js",
    "test:hr-personnel-boundary": "tsx src/services/__tests__/hrPersonnelBoundary.test.ts",
    "test:dispatch-master-data": "tsx src/services/__tests__/dispatchMasterDataPolicy.test.ts",
    "test:hr-candidate-access": "tsx src/services/__tests__/hrCandidateAccess.test.ts",
    "test:hr-candidate-correction": "tsx src/services/__tests__/hrCandidateCorrection.test.ts",
    "test:hr-offer-decision": "tsx src/services/__tests__/hrOfferDecision.test.ts",
    "test:hr-offer-sms": "tsx src/services/__tests__/hrHiringOfferSms.test.ts",
    "test:hr-candidate-assessment": "tsx src/services/__tests__/hrCandidateAssessment.test.ts",
    "test:hr-hiring-lifecycle": "tsx src/services/__tests__/hrHiringLifecycle.test.ts && tsx src/services/__tests__/hrEmploymentContract.test.ts && tsx src/services/__tests__/hrInsuranceEnrollment.test.ts && tsx src/services/__tests__/hrPayrollParticipation.test.ts && tsx src/services/__tests__/hrHiringDocumentIndex.test.ts && tsx src/services/__tests__/hrHiringDocumentEvidence.test.ts && tsx src/services/__tests__/hrEmploymentActivation.test.ts && tsx src/services/__tests__/hrWorkScheduleGovernance.test.ts",
    "test:hr-work-items": "tsx src/services/__tests__/hrWorkItems.test.ts",
    "test:hr-record-retention": "tsx src/services/__tests__/hrRecordRetentionPolicy.test.ts && tsx src/services/__tests__/hrDeletionFileTransaction.test.ts && tsx src/services/__tests__/hrPersonnelErasureGraph.test.ts && tsx src/services/__tests__/hrPersonnelErasureRecovery.test.ts && tsx src/services/__tests__/hrApplicationDecisionVersions.test.ts && tsx src/services/__tests__/hrHiringAuthorityPolicy.test.ts",
    "test:user-deletion-policy": "tsx src/services/__tests__/userDeletionPolicy.test.ts",
    "test:system-recovery": "tsx src/services/__tests__/systemRecoveryPolicy.test.ts && tsx src/services/__tests__/recoveryCrypto.test.ts",
    "test:notifications": "tsx src/services/__tests__/notificationPolicy.test.ts",
    "test:support-tickets": "tsx src/services/__tests__/supportTicketPolicy.test.ts",
    "test:biometric-connector": "tsx src/services/__tests__/biometricConnector.test.ts",
    "test:shipment-quantities": "tsx src/services/__tests__/shipmentQuantityProjection.test.ts && tsx src/services/__tests__/shipmentContractQuantityVersion.test.ts && tsx src/routes/__tests__/shipmentQuantityApi.test.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/prisma/seed.ts",
    "migrate:legacy-customers:dry": "tsx scripts/migrate-legacy-customers-to-crm.ts",
    "migrate:legacy-customers:apply": "tsx scripts/migrate-legacy-customers-to-crm.ts --apply",
    "backfill:crm-customer-owners:dry": "tsx scripts/backfill-crm-customer-owners.ts",
    "backfill:crm-customer-owners:apply": "tsx scripts/backfill-crm-customer-owners.ts --apply",
