    "verify:security-attendance-migration": "tsx scripts/verify-security-attendance-migration.ts",
    "preview:security-shift-pdf": "tsx scripts/render-security-completed-shift-preview.ts",
    "verify:dispatch-master-data": "tsx scripts/verify-dispatch-master-data.ts",
    "verify:guard-driver-queue": "tsx scripts/verify-guard-driver-queue.ts",
    "verify:dispatch-allocations": "tsx scripts/verify-dispatch-allocations-waybills.ts",
    "verify:dispatch-confirmation": "tsx scripts/verify-dispatch-confirmation.ts",
