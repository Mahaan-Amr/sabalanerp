generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                         String                               @id @default(cuid())
  email                                      String                               @unique
  username                                   String                               @unique
  password                                   String
  firstName                                  String
  lastName                                   String
  role                                       UserRole                             @default(USER)
  isActive                                   Boolean                              @default(true)
  createdAt                                  DateTime                             @default(now())
  updatedAt                                  DateTime                             @updatedAt
  departmentId                               String?
  personnelId                                String?                              @unique
  mustChangePassword                         Boolean                              @default(false)
  creationSource                             UserCreationSource                   @default(LEGACY)
  creatorAttributionKind                     CreatorAttributionKind               @default(UNKNOWN)
  createdByUserId                            String?
  creatorDisplayNameSnapshot                 String?
  creatorUsernameSnapshot                    String?
  creatorAttributedById                      String?
  creatorAttributionReason                   String?
  creatorAttributedAt                        DateTime?
  erasedAt                                   DateTime?
  erasureReason                              String?
  erasedById                                 String?
  erasedDisplayName                          String?
  erasedUsernameSnapshot                     String?
  attendanceRecords                          AttendanceRecord[]
  comments                                   Comment[]
  createdTemplates                           ContractTemplate[]
  approvedContracts                          Contract[]                           @relation("ContractApprovedBy")
  createdContracts                           Contract[]                           @relation("ContractCreatedBy")
  signedContracts                            Contract[]                           @relation("ContractSignedBy")
  approvedExceptions                         ExceptionRequest[]                   @relation("ExceptionApprover")
  cancelledExceptions                        ExceptionRequest[]                   @relation("ExceptionCanceller")
  createdExceptionRequests                   ExceptionRequest[]                   @relation("ExceptionCreatedBy")
  exceptionRequests                          ExceptionRequest[]                   @relation("ExceptionEmployee")
  rejectedExceptions                         ExceptionRequest[]                   @relation("ExceptionRejecter")
  approvedMissions                           MissionAssignment[]                  @relation("MissionApprover")
  assignedMissions                           MissionAssignment[]                  @relation("MissionAssigner")
  missionAssignments                         MissionAssignment[]                  @relation("MissionEmployee")
  orders                                     Order[]
  posts                                      Post[]
  profile                                    Profile?
  approvedSalesContracts                     SalesContract[]                      @relation("SalesContractApprovedBy")
  createdSalesContracts                      SalesContract[]                      @relation("SalesContractCreatedBy")
  signedSalesContracts                       SalesContract[]                      @relation("SalesContractSignedBy")
  responsibleSalesContracts                  SalesContract[]                      @relation("SalesContractResponsibleSeller")
  realizedSalesContracts                     SalesContract[]                      @relation("SalesContractRealizedSeller")
  previousSalesAssignments                   SalesContractSellerAudit[]           @relation("SalesContractPreviousSeller")
  nextSalesAssignments                       SalesContractSellerAudit[]           @relation("SalesContractNextSeller")
  changedSalesAssignments                    SalesContractSellerAudit[]           @relation("SalesContractAssignmentActor")
  salesReportingEvents                       SalesReportingEvent[]                @relation("SalesReportingEventSeller")
  createdSalesReportingEvents                SalesReportingEvent[]                @relation("SalesReportingEventActor")
  salesReportPresets                         SalesReportPreset[]                  @relation("SalesReportPresetOwner")
  securityPersonnel                          SecurityPersonnel?
  department                                 Department?                          @relation(fields: [departmentId], references: [id])
  personnel                                  Personnel?                           @relation(fields: [personnelId], references: [id], onDelete: SetNull)
  grantedPermissions                         WorkspacePermission[]                @relation("PermissionGranter")
  workspacePermissions                       WorkspacePermission[]
  grantedFeaturePermissions                  FeaturePermission[]                  @relation("FeaturePermissionGranter")
  featurePermissions                         FeaturePermission[]
  ownedCrmCustomers                          CrmCustomer[]                        @relation("CrmCustomerOwner")
  createdCrmCustomers                        CrmCustomer[]                        @relation("CrmCustomerCreatedBy")
  updatedCrmCustomers                        CrmCustomer[]                        @relation("CrmCustomerUpdatedBy")
  responsibleCrmPotentialProjects            CrmPotentialProject[]                @relation("CrmPotentialProjectResponsibleSeller")
  createdCrmPotentialProjects                CrmPotentialProject[]                @relation("CrmPotentialProjectCreatedBy")
  crmFollowUpReports                         CrmFollowUpReport[]                  @relation("CrmFollowUpSeller")
  assignedCrmNextActions                     CrmNextAction[]                      @relation("CrmNextActionAssignee")
  completedCrmNextActions                    CrmNextAction[]                      @relation("CrmNextActionCompletedBy")
  crmTimelineEvents                          CrmTimelineEvent[]                   @relation("CrmTimelineActor")
  logisticsDrivers                           LogisticsDriver[]                    @relation("LogisticsDriverCreatedBy")
  securityVehiclePairs                       SecurityVehiclePair[]                @relation("SecurityVehiclePairCreatedBy")
  createdSecurityAttendanceRosterMemberships SecurityAttendanceRosterMembership[] @relation("SecurityAttendanceRosterCreatedBy")
  endedSecurityAttendanceRosterMemberships   SecurityAttendanceRosterMembership[] @relation("SecurityAttendanceRosterEndedBy")
  requestedLoadingDrivers                    LogisticsDriverRequest[]             @relation("LogisticsDriverRequestRequestedBy")
  fulfilledLoadingDrivers                    LogisticsDriverRequest[]             @relation("LogisticsDriverRequestFulfilledBy")
  cancelledLoadingDrivers                    LogisticsDriverRequest[]             @relation("LogisticsDriverRequestCancelledBy")
  instantReportParticipants                  SecurityShiftLogParticipant[]
  recordedAttendanceIntervalEntries          AttendanceInterval[]                 @relation("AttendanceIntervalEntryRecorder")
  recordedAttendanceIntervalExits            AttendanceInterval[]                 @relation("AttendanceIntervalExitRecorder")
  attendanceIntervalAuditEvents              AttendanceIntervalAudit[]            @relation("AttendanceIntervalAuditActor")
  attendanceWorkflowEvents                   SecurityAttendanceWorkflowEvent[]    @relation("SecurityAttendanceWorkflowActor")
  createdByUser                              User?                                @relation("UserCreationActor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers                               User[]                               @relation("UserCreationActor")
  creatorAttributedBy                        User?                                @relation("UserCreatorAttributionActor", fields: [creatorAttributedById], references: [id], onDelete: SetNull)
  creatorAttributions                        User[]                               @relation("UserCreatorAttributionActor")
  erasedBy                                   User?                                @relation("UserErasureActor", fields: [erasedById], references: [id], onDelete: SetNull)
  erasedUsers                                User[]                               @relation("UserErasureActor")
  authSessions                               AuthSession[]                        @relation("AuthSessionOwner")
  revokedAuthSessions                        AuthSession[]                        @relation("AuthSessionRevoker")
  browserProfiles                            RecognizedBrowserProfile[]
  authenticationEvents                       AuthenticationEvent[]                @relation("AuthenticationEventUser")
  authenticationActions                      AuthenticationEvent[]                @relation("AuthenticationEventActor")
  securityNotifications                      SecurityNotification[]
  personnelBulkOperations                    PersonnelBulkOperation[]             @relation("PersonnelBulkOperationActor")
  userBulkOperations                         UserBulkOperation[]                  @relation("UserBulkOperationActor")

  @@index([createdByUserId])
  @@index([erasedAt])
  @@map("users")
}

enum UserCreationSource {
  LEGACY
  MANAGED
  IMPORTED
  SYSTEM_SEEDED
}

enum CreatorAttributionKind {
  UNKNOWN
  AUTOMATIC
  MANUAL
}

model RecognizedBrowserProfile {
  id              String        @id @default(cuid())
  publicId        String
  userId          String
  label           String?
  browser         String?
  operatingSystem String?
  deviceCategory  String?
  firstSeenAt     DateTime      @default(now())
  lastSeenAt      DateTime      @default(now())
  firstIp         String?
  lastIp          String?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions        AuthSession[]

  @@unique([userId, publicId])
  @@index([userId, lastSeenAt])
  @@map("recognized_browser_profiles")
}

model AuthSession {
  id                  String                    @id @default(cuid())
  tokenHash           String                    @unique
  userId              String
  browserProfileId    String?
  ipAddress           String?
  userAgent           String?
  browser             String?
  operatingSystem     String?
  deviceCategory      String?
  approximateLocation String?
  isNewBrowser        Boolean                   @default(false)
  authenticatedAt     DateTime                  @default(now())
  lastActivityAt      DateTime                  @default(now())
  idleExpiresAt       DateTime
  absoluteExpiresAt   DateTime
  revokedAt           DateTime?
  revokedById         String?
  revocationReason    String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  user                User                      @relation("AuthSessionOwner", fields: [userId], references: [id], onDelete: Cascade)
  browserProfile      RecognizedBrowserProfile? @relation(fields: [browserProfileId], references: [id], onDelete: SetNull)
  revokedBy           User?                     @relation("AuthSessionRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, absoluteExpiresAt])
  @@index([lastActivityAt])
  @@map("auth_sessions")
}

model AuthenticationEvent {
  id                  String   @id @default(cuid())
  type                String
  userId              String?
  actorId             String?
  attemptedIdentifier String?
  ipAddress           String?
  userAgent           String?
  browser             String?
  operatingSystem     String?
  deviceCategory      String?
  approximateLocation String?
  safeCategory        String?
  sessionIdSnapshot   String?
  reason              String?
  details             Json?
  createdAt           DateTime @default(now())
  user                User?    @relation("AuthenticationEventUser", fields: [userId], references: [id], onDelete: SetNull)
  actor               User?    @relation("AuthenticationEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([attemptedIdentifier, createdAt])
  @@index([ipAddress, createdAt])
  @@map("authentication_events")
}

model SecurityNotification {
  id          String    @id @default(cuid())
  userId      String
  type        String
  title       String
  message     String
  referenceId String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("security_notifications")
}

model PersonnelBulkOperation {
  id            String    @id @default(cuid())
  actorId       String
  operation     String
  previewToken  String    @unique
  selectionHash String
  status        String
  requestedData Json?
  previewData   Json
  resultData    Json?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  actor         User      @relation("PersonnelBulkOperationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@map("personnel_bulk_operations")
}

model UserBulkOperation {
  id            String    @id @default(cuid())
  actorId       String
  operation     String
  previewToken  String    @unique
  selectionHash String
  status        String
  requestedData Json?
  previewData   Json
  resultData    Json?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  actor         User      @relation("UserBulkOperationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@map("user_bulk_operations")
}

model Personnel {
  id                                  String                               @id @default(cuid())
  firstName                           String
  lastName                            String
  nationalCode                        String?                              @unique
  employeeNumber                      String?                              @unique
  departmentId                        String?
  isActive                            Boolean                              @default(true)
  createdAt                           DateTime                             @default(now())
  updatedAt                           DateTime                             @updatedAt
  attendanceRecords                   AttendanceRecord[]
  workSchedules                       PersonnelWorkSchedule[]
  securityAttendanceRosterMemberships SecurityAttendanceRosterMembership[]
  instantReportParticipants           SecurityShiftLogParticipant[]
  exceptionRequests                   ExceptionRequest[]
  missionAssignments                  MissionAssignment[]
  user                                User?
  department                          Department?                          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  hrEmploymentRelationships           HrEmploymentRelationship[]
  hiringCandidate                     HrCandidate?
  hiringOnboardingTasks               HrOnboardingTask[]
  hrPersonnelAudits                   HrPersonnelAudit[]

  @@index([isActive, departmentId])
  @@index([lastName, firstName])
  @@map("personnel")
}

model HrPersonnelAudit {
  id             String    @id @default(cuid())
  personnelId    String
  actorUserId    String
  eventType      String
  sourceCategory String
  reason         String
  payloadJson    Json?
  createdAt      DateTime  @default(now())
  personnel      Personnel @relation(fields: [personnelId], references: [id], onDelete: Restrict)

  @@index([personnelId, createdAt])
  @@index([eventType, createdAt])
  @@map("hr_personnel_audits")
}

model PersonnelWorkSchedule {
  id            String                     @id @default(cuid())
  personnelId   String
  effectiveFrom DateTime
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  personnel     Personnel                  @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  days          PersonnelWorkScheduleDay[]

  @@unique([personnelId, effectiveFrom])
  @@index([personnelId, effectiveFrom])
  @@map("personnel_work_schedules")
}

model PersonnelWorkScheduleDay {
  id         String                @id @default(cuid())
  scheduleId String
  weekday    Int
  startTime  String
  endTime    String
  schedule   PersonnelWorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, weekday])
  @@index([weekday])
  @@map("personnel_work_schedule_days")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  avatar    String?
  bio       String?
  phone     String?
  address   String?
  city      String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Post {
  id        String    @id @default(cuid())
  title     String
  content   String
  published Boolean   @default(false)
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)
  total       Decimal     @db.Decimal(10, 2)
  customerId  String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  customer    User        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("orders")
}

model Department {
  id             String          @id @default(cuid())
  name           String          @unique
  namePersian    String          @unique
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  contracts      Contract[]
  salesContracts SalesContract[] @relation("SalesContractDepartment")
  users          User[]
  personnel      Personnel[]

  @@map("departments")
}

// Legacy customer model used by old contract endpoints.
// New sales contract flow should use CrmCustomer.
model Customer {
  id          String     @id @default(cuid())
  firstName   String
  lastName    String
  companyName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String     @default("ایران")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  contracts   Contract[]

  @@map("customers")
}

model ContractTemplate {
  id             String          @id @default(cuid())
  name           String
  namePersian    String
  description    String?
  content        String
  variables      Json?
  isActive       Boolean         @default(true)
  createdBy      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  calculations   Json?
  category       String?
  structure      Json?
  createdByUser  User            @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  contracts      Contract[]
  salesContracts SalesContract[] @relation("SalesContractTemplate")

  @@map("contract_templates")
}

model Contract {
  id             String            @id @default(cuid())
  contractNumber String            @unique
  title          String
  titlePersian   String
  content        String
  status         ContractStatus    @default(DRAFT)
  customerId     String
  departmentId   String
  templateId     String?
  createdBy      String
  approvedBy     String?
  signedBy       String?
  signedAt       DateTime?
  printedAt      DateTime?
  totalAmount    Decimal?          @db.Decimal(15, 2)
  currency       String            @default("تومان")
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  calculations   Json?
  contractData   Json?
  signatures     Json?
  approvedByUser User?             @relation("ContractApprovedBy", fields: [approvedBy], references: [id])
  createdByUser  User              @relation("ContractCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  department     Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  signedByUser   User?             @relation("ContractSignedBy", fields: [signedBy], references: [id])
  template       ContractTemplate? @relation(fields: [templateId], references: [id])

  @@map("contracts")
}

model Shift {
  id                String                     @id @default(cuid())
  name              String                     @unique
  namePersian       String                     @unique
  startTime         String
  endTime           String
  duration          Int
  isActive          Boolean                    @default(true)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  attendanceRecords AttendanceRecord[]
  securityPersonnel SecurityPersonnel[]
  supervisorReports SecuritySupervisorReport[]

  @@map("shifts")
}

model SecurityPersonnel {
  id                String                           @id @default(cuid())
  userId            String                           @unique
  shiftId           String
  position          String
  isActive          Boolean                          @default(true)
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt
  attendanceRecords AttendanceRecord[]
  primaryAPlans     SecurityShiftPlan[]              @relation("SecurityShiftPlanPrimaryA")
  primaryBPlans     SecurityShiftPlan[]              @relation("SecurityShiftPlanPrimaryB")
  primaryCPlans     SecurityShiftPlan[]              @relation("SecurityShiftPlanPrimaryC")
  plannedSlots      SecurityShiftPlanSlot[]          @relation("SecurityShiftPlannedPersonnel")
  replacementSlots  SecurityShiftPlanSlot[]          @relation("SecurityShiftReplacementPersonnel")
  shiftAttendances  SecurityShiftAttendance[]
  shiftSessions     SecurityShiftSession[]
  patrolSessions    SecurityPatrolSession[]
  temporaryCoverage SecurityShiftTemporaryCoverage[]
  shift             Shift                            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user              User                             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("security_personnel")
}

model SecurityShiftPlan {
  id                  String                  @id @default(cuid())
  title               String
  persianYear         Int
  revision            Int                     @default(1)
  status              SecurityShiftPlanStatus @default(DRAFT)
  anchorAt            DateTime
  generateUntil       DateTime
  slotDurationMinutes Int                     @default(720)
  earlyArrivalMinutes Int                     @default(30)
  lateAlertMinutes    Int                     @default(15)
  primaryAId          String
  primaryBId          String
  primaryCId          String
  replacesPlanId      String?
  createdBy           String
  publishedBy         String?
  publishedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  primaryA            SecurityPersonnel       @relation("SecurityShiftPlanPrimaryA", fields: [primaryAId], references: [id], onDelete: Restrict)
  primaryB            SecurityPersonnel       @relation("SecurityShiftPlanPrimaryB", fields: [primaryBId], references: [id], onDelete: Restrict)
  primaryC            SecurityPersonnel       @relation("SecurityShiftPlanPrimaryC", fields: [primaryCId], references: [id], onDelete: Restrict)
  slots               SecurityShiftPlanSlot[]

  @@index([persianYear, status])
  @@index([anchorAt, generateUntil])
  @@map("security_shift_plans")
}

model SecurityShiftPlanSlot {
  id                     String                           @id @default(cuid())
  planId                 String
  sequence               Int
  startsAt               DateTime
  endsAt                 DateTime
  plannedPersonnelId     String
  replacementPersonnelId String?
  coverageStatus         SecurityShiftCoverageStatus      @default(COVERED)
  leaveRequestId         String?
  overrideReason         String?
  probableNoShowAt       DateTime?
  noShiftConfirmedAt     DateTime?
  noShiftConfirmedBy     String?
  noShiftConfirmedByName String?
  noShiftConfirmReason   String?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  plan                   SecurityShiftPlan                @relation(fields: [planId], references: [id], onDelete: Cascade)
  plannedPersonnel       SecurityPersonnel                @relation("SecurityShiftPlannedPersonnel", fields: [plannedPersonnelId], references: [id], onDelete: Restrict)
  replacementPersonnel   SecurityPersonnel?               @relation("SecurityShiftReplacementPersonnel", fields: [replacementPersonnelId], references: [id], onDelete: Restrict)
  attendance             SecurityShiftAttendance[]
  session                SecurityShiftSession?
  temporaryCoverage      SecurityShiftTemporaryCoverage[]
  report                 SecuritySupervisorReport?

  @@unique([planId, sequence])
  @@index([startsAt, endsAt])
  @@index([plannedPersonnelId, startsAt])
  @@index([replacementPersonnelId, startsAt])
  @@index([coverageStatus, startsAt])
  @@index([probableNoShowAt])
  @@map("security_shift_plan_slots")
}

model SecurityShiftAttendance {
  id                String                @id @default(cuid())
  slotId            String
  personnelId       String
  arrivedAt         DateTime              @default(now())
  delayMinutes      Int                   @default(0)
  originalArrivedAt DateTime?
  correctedAt       DateTime?
  correctedBy       String?
  correctionReason  String?
  createdAt         DateTime              @default(now())
  slot              SecurityShiftPlanSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  personnel         SecurityPersonnel     @relation(fields: [personnelId], references: [id], onDelete: Restrict)

  @@unique([slotId, personnelId])
  @@index([personnelId, arrivedAt])
  @@map("security_shift_attendance")
}

model SecurityShiftSession {
  id               String                           @id @default(cuid())
  slotId           String                           @unique
  personnelId      String
  status           SecurityShiftSessionStatus       @default(ACTIVE)
  startedAt        DateTime                         @default(now())
  endedAt          DateTime?
  overtimeMinutes  Int                              @default(0)
  forceClosedBy    String?
  forceCloseReason String?
  closureSummary   String?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  slot             SecurityShiftPlanSlot            @relation(fields: [slotId], references: [id], onDelete: Restrict)
  personnel        SecurityPersonnel                @relation(fields: [personnelId], references: [id], onDelete: Restrict)
  logEntries       SecurityShiftLogEntry[]
  patrolSessions   SecurityPatrolSession[]
  corrections      SecurityShiftSessionCorrection[]

  @@index([status, startedAt])
  @@index([personnelId, startedAt])
  @@map("security_shift_sessions")
}

model SecurityShiftSessionCorrection {
  id                 String               @id @default(cuid())
  sessionId          String
  correctedBy        String
  correctedByName    String
  reason             String
  previousStartedAt  DateTime?
  previousEndedAt    DateTime?
  effectiveStartedAt DateTime
  effectiveEndedAt   DateTime?
  reconstructedStart Boolean              @default(false)
  reconstructedEnd   Boolean              @default(false)
  correctedAt        DateTime             @default(now())
  session            SecurityShiftSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, correctedAt])
  @@index([correctedBy, correctedAt])
  @@map("security_shift_session_corrections")
}

model SecurityShiftTemporaryCoverage {
  id          String                @id @default(cuid())
  slotId      String
  personnelId String
  startsAt    DateTime
  endsAt      DateTime
  note        String?
  assignedBy  String
  createdAt   DateTime              @default(now())
  slot        SecurityShiftPlanSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  personnel   SecurityPersonnel     @relation(fields: [personnelId], references: [id], onDelete: Restrict)

  @@index([slotId, startsAt])
  @@index([personnelId, startsAt])
  @@map("security_shift_temporary_coverage")
}

model AttendanceRecord {
  id                    String                        @id @default(cuid())
  employeeId            String?
  personnelId           String?
  securityPersonnelId   String?
  date                  DateTime
  shiftId               String?
  entryTime             String?
  exitTime              String?
  status                AttendanceStatus              @default(PRESENT)
  exceptionType         String?
  exceptionTime         String?
  exceptionDuration     Int?
  digitalSignature      String?
  notes                 String?
  personnelFirstName    String?
  personnelLastName     String?
  departmentId          String?
  departmentName        String?
  departmentNamePersian String?
  workScheduleStatus    AttendanceWorkScheduleStatus?
  scheduledStartTime    String?
  scheduledEndTime      String?
  delayMinutes          Int?
  overtimeMinutes       Int?
  overtimePending       Boolean                       @default(false)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  employee              User?                         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  personnel             Personnel?                    @relation(fields: [personnelId], references: [id], onDelete: Restrict)
  securityPersonnel     SecurityPersonnel?            @relation(fields: [securityPersonnelId], references: [id], onDelete: SetNull)
  shift                 Shift?                        @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  intervals             AttendanceInterval[]

  @@index([personnelId, date])
  @@index([employeeId, date])
  @@map("attendance_records")
}

model AttendanceInterval {
  id                 String                    @id @default(cuid())
  attendanceRecordId String
  enteredAt          DateTime
  exitedAt           DateTime?
  entryRecordedBy    String
  exitRecordedBy     String?
  entryReason        String?
  exitReason         String?
  status             AttendanceIntervalStatus  @default(ACTIVE)
  voidReason         String?
  voidedAt           DateTime?
  voidedBy           String?
