model CrossWorkspaceDutyEnvelope {
  id                       String               @id @default(cuid())
  code                     String
  version                  Int
  destinationWorkspaceCode String
  destinationFeatureCode   String?
  allowedFieldsJson        Json
  allowedEvidenceJson      Json
  allowedActionCodesJson   Json
  responseSchemaJson       Json
  isActive                 Boolean              @default(true)
  createdByUserId          String
  createdAt                DateTime             @default(now())
  duties                   CrossWorkspaceDuty[]

  @@unique([code, version])
  @@map("hr_duty_envelopes")
}

model CrossWorkspaceDuty {
  id                            String                                   @id @default(cuid())
  stableKey                     String                                   @unique
  sourceType                    String
  sourceId                      String
  sourceActionCode              String
  sourceVersion                 Int
  envelopeCode                  String
  envelopeVersion               Int
  destinationWorkspaceCode      String
  destinationQueueCode          String
  status                        HrDutyStatus                             @default(OPEN)
  currentAssigneeUserId         String?
  responsibilityId              String?
  routingResponsibilityTypeCode String?
  routingScopeType              String?
  routingScopeId                String?
  sourceActorUserId             String?
  dueAt                         DateTime
  structuredResultJson          Json?
  respondedAt                   DateTime?
  respondedByUserId             String?
  predecessorDutyId             String?
  createdByUserId               String
  createdAt                     DateTime                                 @default(now())
  updatedAt                     DateTime                                 @updatedAt
  envelope                      CrossWorkspaceDutyEnvelope               @relation(fields: [envelopeCode, envelopeVersion], references: [code, version], onDelete: Restrict)
  responsibility                HrNamedResponsibility?                   @relation(fields: [responsibilityId], references: [id], onDelete: Restrict)
  predecessor                   CrossWorkspaceDuty?                      @relation("CrossWorkspaceDutySuccessors", fields: [predecessorDutyId], references: [id], onDelete: Restrict)
  successors                    CrossWorkspaceDuty[]                     @relation("CrossWorkspaceDutySuccessors")
  assignmentHistory             CrossWorkspaceDutyAssignmentHistory[]
  auditVersions                 CrossWorkspaceDutyAuditVersion[]
  notificationIdentities        CrossWorkspaceDutyNotificationIdentity[]

  @@unique([sourceType, sourceId, sourceActionCode, sourceVersion])
  @@index([currentAssigneeUserId, status, dueAt])
  @@index([destinationWorkspaceCode, destinationQueueCode, status, dueAt])
  @@index([routingResponsibilityTypeCode, routingScopeType, routingScopeId, status], map: "hr_duties_routingResponsibilityTypeCode_routingScopeType_idx")
  @@map("hr_duties")
}

model CrossWorkspaceDutyAssignmentHistory {
  id                       String                     @id @default(cuid())
  dutyId                   String
  sequence                 Int
  assignedUserId           String?
  responsibilityId         String?
  destinationWorkspaceCode String
  destinationQueueCode     String
  startedAt                DateTime                   @default(now())
  endedAt                  DateTime?
  endReason                HrDutyAssignmentEndReason?
  changedByUserId          String?
  policyVersion            Int
  createdAt                DateTime                   @default(now())
  duty                     CrossWorkspaceDuty         @relation(fields: [dutyId], references: [id], onDelete: Restrict)
  responsibility           HrNamedResponsibility?     @relation(fields: [responsibilityId], references: [id], onDelete: Restrict)

  @@unique([dutyId, sequence])
  @@index([assignedUserId, endedAt])
  @@map("hr_duty_assignment_history")
}

model CrossWorkspaceDutyAuditVersion {
