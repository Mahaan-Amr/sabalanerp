  currency        String                     @default("ریال")
  dueDate         DateTime
  status          ReceivableStatus           @default(OPEN)
  metadata        Json?
  createdBy       String
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
