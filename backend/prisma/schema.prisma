  assignments         HrEmploymentAssignment[]
  hiringApplication   HrJobApplication?        @relation(fields: [hiringApplicationId], references: [id], onDelete: SetNull)

  @@unique([sourceSystem, sourceId])
  @@index([personnelId, status, effectiveFrom, effectiveTo])
  @@map("hr_employment_relationships")
}

model HrEmploymentAssignment {
  id                                String                   @id @default(cuid())
