}

model HrNamedResponsibility {
  id                        String                                @id @default(cuid())
  stableKey                 String                                @unique
  responsibilityTypeCode    String
  scopeType                 String
  scopeId                   String?
  assignedUserId            String?
  assignmentKind            HrResponsibilityAssignmentKind        @default(PRIMARY)
  principalResponsibilityId String?
  effectiveFrom             DateTime
  effectiveTo               DateTime?
  reason                    String?
  createdByUserId           String
  provenanceVersion         Int                                   @default(1)
  createdAt                 DateTime                              @default(now())
  updatedAt                 DateTime                              @updatedAt
  duties                    CrossWorkspaceDuty[]
  dutyAssignmentHistory     CrossWorkspaceDutyAssignmentHistory[]
  responsibilityType        HrResponsibilityTypeCatalog           @relation(fields: [responsibilityTypeCode], references: [code], onDelete: Restrict)
  principal                 HrNamedResponsibility?                @relation("HrResponsibilityDelegates", fields: [principalResponsibilityId], references: [id], onDelete: Restrict)
  delegates                 HrNamedResponsibility[]               @relation("HrResponsibilityDelegates")

  @@index([responsibilityTypeCode, scopeType, scopeId, effectiveFrom, effectiveTo])
  @@index([assignedUserId, effectiveFrom, effectiveTo])
  @@map("hr_named_responsibilities")
}

model HrResponsibilityDestination {
