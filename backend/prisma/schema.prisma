  version                Int
  eventCode              String
  actorUserId            String?
  sourceVersion          Int
  envelopeVersion        Int
  policyVersion          Int
  beforeJson             Json?
  afterJson              Json?
  reason                 String?
  createdAt              DateTime                                 @default(now())
  duty                   CrossWorkspaceDuty                       @relation(fields: [dutyId], references: [id], onDelete: Restrict)
