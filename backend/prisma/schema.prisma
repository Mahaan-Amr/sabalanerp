model HrFormalAssessmentPlan {
  id                     String                            @id @default(cuid())
  stableKey              String                            @unique
  applicationId          String
  version                Int
  status                 HrFormalAssessmentPlanStatus      @default(ACTIVE)
  explicitlyNoAssessment Boolean                           @default(false)
  executionMethod        HrAssessmentExecutionMethod?
  finalizedByUserId      String
  finalizedAt            DateTime                          @default(now())
  reason                 String?
  predecessorPlanId      String?
  createdAt              DateTime                          @default(now())
  application            HrJobApplication                  @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  predecessor            HrFormalAssessmentPlan?           @relation("HrAssessmentPlanVersions", fields: [predecessorPlanId, applicationId], references: [id, applicationId], onDelete: Restrict)
  successors             HrFormalAssessmentPlan[]          @relation("HrAssessmentPlanVersions")
  selections             HrFormalAssessmentPlanSelection[]
  results                HrFormalAssessmentResult[]

  @@unique([applicationId, version])
  @@unique([id, applicationId])
  @@index([applicationId, status])
  @@map("hr_formal_assessment_plans")
}

model HrFormalAssessmentPlanSelection {
  id              String                       @id @default(cuid())
  planId          String
  assessmentKind  HrFormalAssessmentKind
  selected        Boolean
  executionMethod HrAssessmentExecutionMethod?
  createdAt       DateTime                     @default(now())
  plan            HrFormalAssessmentPlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  results         HrFormalAssessmentResult[]

  @@unique([planId, assessmentKind])
  @@unique([id, planId, assessmentKind])
  @@map("hr_formal_assessment_plan_selections")
}

model HrFormalAssessmentResult {
  id                  String                          @id @default(cuid())
  stableKey           String                          @unique
  applicationId       String
  planId              String
  planSelectionId     String
  assessmentKind      HrFormalAssessmentKind
  resultVersion       Int
  status              HrFormalAssessmentResultStatus  @default(PENDING)
  resultJson          Json?
  recordedByUserId    String?
  recordedAt          DateTime?
  supersedesResultId  String?
  invalidatedAt       DateTime?
  invalidatedByUserId String?
  invalidationReason  String?
  createdAt           DateTime                        @default(now())
  application         HrJobApplication                @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  plan                HrFormalAssessmentPlan          @relation(fields: [planId, applicationId], references: [id, applicationId], onDelete: Restrict)
  planSelection       HrFormalAssessmentPlanSelection @relation(fields: [planSelectionId, planId, assessmentKind], references: [id, planId, assessmentKind], onDelete: Restrict)
  supersedes          HrFormalAssessmentResult?       @relation("HrAssessmentResultVersions", fields: [supersedesResultId, applicationId, assessmentKind], references: [id, applicationId, assessmentKind], onDelete: Restrict)
  supersededBy        HrFormalAssessmentResult[]      @relation("HrAssessmentResultVersions")
  attempts            HrFormalAssessmentAttempt[]

  @@unique([applicationId, assessmentKind, resultVersion])
  @@unique([id, applicationId, assessmentKind])
  @@index([planSelectionId, status])
  @@map("hr_formal_assessment_results")
}

model HrFormalAssessmentAttempt {
  id              String                           @id @default(cuid())
  stableKey       String                           @unique
  resultId        String
  attemptNumber   Int
