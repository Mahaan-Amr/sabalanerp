  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  invoice        AccountingFinancialRecord @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("accounting_invoice_candidate_items")
}

model AccountingReceivable {
  id              String                     @id @default(cuid())
  contractId      String?
  invoiceRecordId String?
  sourcePaymentId String?
  customerId      String?
  originalAmount  Decimal                    @db.Decimal(18, 2)
  paidAmount      Decimal                    @default(0) @db.Decimal(18, 2)
