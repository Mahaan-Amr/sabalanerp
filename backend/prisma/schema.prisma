}

model HrAuthorityCatalog {
  id          String                     @id @default(cuid())
  code        String                     @unique
  version     Int                        @default(1)
  displayName String
  isActive    Boolean                    @default(true)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  grants      HrBusinessAuthorityGrant[]

  @@map("hr_authority_catalogs")
}

model HrResponsibilityTypeCatalog {
  id                          String                         @id @default(cuid())
  code                        String                         @unique
  version                     Int                            @default(1)
  displayName                 String
  isActive                    Boolean                        @default(true)
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  responsibilities            HrNamedResponsibility[]
  destinations                HrResponsibilityDestination[]
  separationOfDutyConstraints HrSeparationOfDutyConstraint[]

  @@map("hr_responsibility_type_catalogs")
}

model HrWorkspaceAccessGrant {
  id                String             @id @default(cuid())
  stableKey         String             @unique
  userId            String
  workspaceCode     String
  level             HrAccessLevel
  status            HrGrantStatus      @default(ACTIVE)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  grantedByUserId   String?
  revokedByUserId   String?
  revokedAt         DateTime?
  reason            String?
  provenanceVersion Int                @default(1)
  legacyGrantId     String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workspace         HrWorkspaceCatalog @relation(fields: [workspaceCode], references: [code], onDelete: Restrict)

  @@index([userId, workspaceCode, status, effectiveFrom, effectiveTo])
  @@map("hr_workspace_access_grants")
}

model HrFeatureAccessGrant {
  id                String           @id @default(cuid())
  stableKey         String           @unique
  userId            String
  featureCode       String
  level             HrAccessLevel
  status            HrGrantStatus    @default(ACTIVE)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  grantedByUserId   String?
  revokedByUserId   String?
  revokedAt         DateTime?
  reason            String?
  provenanceVersion Int              @default(1)
  legacyGrantId     String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  feature           HrFeatureCatalog @relation(fields: [featureCode], references: [code], onDelete: Restrict)

  @@index([userId, featureCode, status, effectiveFrom, effectiveTo])
  @@map("hr_feature_access_grants")
}

model HrBusinessAuthorityGrant {
  id                String             @id @default(cuid())
  stableKey         String             @unique
  userId            String
  authorityCode     String
  status            HrGrantStatus      @default(ACTIVE)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  grantedByUserId   String?
  revokedByUserId   String?
  revokedAt         DateTime?
