  costCenter                        HrCostCenter?            @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  responsibleSupervisorAssignment   HrEmploymentAssignment?  @relation("HrResponsibleSupervisor", fields: [responsibleSupervisorAssignmentId], references: [id], onDelete: Restrict)
  supervisedAssignments             HrEmploymentAssignment[] @relation("HrResponsibleSupervisor")

  @@index([employmentRelationshipId, type, effectiveFrom, effectiveTo])
  @@index([positionId, effectiveFrom, effectiveTo])
  @@index([responsibleSupervisorAssignmentId])
  @@map("hr_employment_assignments")
}

