  provenanceVersion Int                @default(1)
  legacyAuthorityId String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  authority         HrAuthorityCatalog @relation(fields: [authorityCode], references: [code], onDelete: Restrict)

  @@index([userId, authorityCode, status, effectiveFrom, effectiveTo])
