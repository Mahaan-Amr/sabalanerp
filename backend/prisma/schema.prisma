  candidateAcceptedName           String?
  candidateDecision               String?
  candidateDecisionAt             DateTime?
  candidateDecisionSource         String?
  candidateDeclineCategory        String?
  candidateDecisionNote           String?
  candidateDecisionBy             String?
  offlineCommunicationMethod      String?
  offlineCommunicatedAt           DateTime?
  offlineReason                   String?
  offlineConfirmedInformation     String?
  candidateNotificationStatus     String?
  candidateNotificationError      String?
  candidateNotificationClaimedAt  DateTime?
  candidateNotificationClaimToken String?
  candidateNotifiedAt             DateTime?
