model HrPayrollParticipation {
  id            String           @id @default(cuid())
  applicationId String           @unique
  effectiveFrom DateTime
  configuredBy  String
  configuredAt  DateTime         @default(now())
  application   HrJobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("hr_payroll_participations")
}

model HrOnboardingTask {
  id                  String                 @id @default(cuid())
  applicationId       String
  title               String
  ownerAuthority      HrHiringAuthorityType
  activationBlocker   Boolean                @default(false)
  dueDate             DateTime?
  status              HrOnboardingTaskStatus @default(PENDING)
  evidenceNote        String?
  completedBy         String?
  completedAt         DateTime?
  createdBy           String
  assigneePersonnelId String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  application         HrJobApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assigneePersonnel   Personnel?             @relation(fields: [assigneePersonnelId], references: [id], onDelete: SetNull)

  @@index([applicationId, status, activationBlocker])
  @@index([assigneePersonnelId, status])
  @@map("hr_onboarding_tasks")
}

model HrHiringAudit {
  id            String           @id @default(cuid())
  applicationId String
  actorUserId   String?
  actorKind     String
  eventType     String
  payloadJson   Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime         @default(now())
  application   HrJobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([eventType, createdAt])
  @@map("hr_hiring_audits")
}
