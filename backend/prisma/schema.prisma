model AccountingSetting {
  id                    String   @id @default(cuid())
  companyEconomicCode   String?
  companyNationalId     String?
  branchCode            String?
  fiscalMemoryId        String?
  defaultVatRate        Decimal  @default(10.00) @db.Decimal(5, 2)
  defaultCurrency       String   @default("ریال")
  invoiceNumberPrefix   String   @default("ACC")
  nextInvoiceSequence   Int      @default(1)
  defaultInvoiceDueDays Int      @default(30)
  requiredTaxFields     Json?
  defaultAccounts       Json?
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("accounting_settings")
}

model AccountingPeriod {
  id               String                      @id @default(cuid())
  code             String                      @unique
  title            String
  startsAt         DateTime
  endsAt           DateTime
  status           AccountingPeriodStatus      @default(OPEN)
  closedAt         DateTime?
  closedBy         String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  financialRecords AccountingFinancialRecord[]
  journalVouchers  JournalVoucher[]

  @@index([status])
  @@map("accounting_periods")
}

model ChartOfAccount {
  id           String               @id @default(cuid())
  code         String               @unique
  title        String
  titlePersian String
  level        AccountLevel
  type         AccountType
  parentId     String?
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  parent       ChartOfAccount?      @relation("ChartAccountHierarchy", fields: [parentId], references: [id])
  children     ChartOfAccount[]     @relation("ChartAccountHierarchy")
  voucherLines JournalVoucherLine[]

  @@index([parentId])
  @@map("chart_of_accounts")
}

model AccountingFinancialRecord {
  id                    String                           @id @default(cuid())
  kind                  FinancialRecordKind
  status                AccountingRecordStatus           @default(DRAFT)
  sourceKind            AccountingSourceKind
  sourceId              String?
  contractId            String?
  customerId            String?
  periodId              String?
  amount                Decimal                          @default(0) @db.Decimal(18, 2)
  currency              String                           @default("ریال")
  sourceSnapshot        Json?
  metadata              Json?
  idempotencyKey        String?                          @unique
  systemInvoiceNumber   String?
  systemInvoiceDate     DateTime?
  sepidarAmount         Decimal?                         @db.Decimal(18, 2)
  financiallyApprovedAt DateTime?
  financiallyApprovedBy String?
  createdBy             String
  postedAt              DateTime?
  voidedAt              DateTime?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  period                AccountingPeriod?                @relation(fields: [periodId], references: [id])
  invoiceItems          AccountingInvoiceCandidateItem[]
  receivables           AccountingReceivable[]
  taxRecords            AccountingTaxRecord[]
  journalVouchers       JournalVoucher[]

  @@index([kind, status])
  @@index([sourceKind, sourceId])
  @@index([contractId])
  @@index([customerId])
  @@index([systemInvoiceNumber])
  @@map("accounting_financial_records")
}

model AccountingInvoiceCandidateItem {
  id             String                    @id @default(cuid())
  invoiceId      String
  contractItemId String?
  productId      String?
  description    String
  quantity       Decimal                   @default(1) @db.Decimal(12, 3)
  unitPrice      Decimal                   @default(0) @db.Decimal(18, 2)
  totalPrice     Decimal                   @default(0) @db.Decimal(18, 2)
  taxRate        Decimal                   @default(0) @db.Decimal(5, 2)
