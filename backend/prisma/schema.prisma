}

model HrEmploymentContractDocument {
  id                String           @id @default(cuid())
  applicationId     String
  version           Int
  contractNumber    String
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  storageName       String
  originalName      String
  mimeType          String
  size              Int
  sha256            String
  malwareScanStatus String
  uploadedBy        String
  submittedBy       String?
  submittedAt       DateTime?
  returnedBy        String?
  returnedAt        DateTime?
  returnReason      String?
  approvedBy        String?
  approvedAt        DateTime?
  note              String?
  createdAt         DateTime         @default(now())
  application       HrJobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, version])
  @@index([applicationId, createdAt])
  @@index([applicationId, submittedAt])
  @@map("hr_employment_contract_documents")
}

model HrInsuranceEnrollment {
  id                  String                      @id @default(cuid())
  applicationId       String                      @unique
  registrationPath    HrInsuranceRegistrationPath @default(COMPANY)
  status              HrInsuranceEnrollmentStatus @default(NOT_STARTED)
  effectiveDate       DateTime?
  dueDate             DateTime?
  communicationMethod String?
  communicatedAt      DateTime?
  note                String?
  updatedBy           String
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  application         HrJobApplication            @relation(fields: [applicationId], references: [id], onDelete: Cascade)

