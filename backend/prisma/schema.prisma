enum HrInsuranceRegistrationPath {
  COMPANY
  INDEPENDENT_REQUEST
}

enum HrOnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  WAIVED
}

enum HrAssessmentType {
  DISC
  BIG_FIVE
  EQ
  OTHER
}

enum HrApplicationDisposition {
  INITIAL_REJECTED
  RESERVE
}

enum HrChecklistItemStatus {
  PENDING
  IN_PROGRESS
  POSITIVE
  NEGATIVE
  CANCELLED
  WAIVED
}

enum HrChecklistEvidencePolicy {
  NOTE_REQUIRED
  FILE_REQUIRED
  FILE_OPTIONAL
  NO_FILE
}

enum HrHiringDecisionKind {
  HR_INTERVIEW
  HR_PRELIMINARY_APPROVAL
  COMPANY_APPROVAL
}

enum HrHiringDecisionOutcome {
  POSITIVE
  NEGATIVE
}

enum HrAssessmentDecision {
  APPROVED
  REPEAT_REQUIRED
  RESERVE
  REJECTED
}

enum HrReopeningStatus {
  AUTHORIZED
  REOPENED
  BLOCKED
}

model HrCandidate {
  id                       String             @id @default(cuid())
  firstName                String
  lastName                 String
  mobile                   String
  nationalCode             String?            @unique
  foreignIdentityType      String?
  foreignIdentityNumber    String?
  postalCode               String?
  hasSocialSecurityHistory Boolean?
  profileJson              Json?
  talentBankSearchable     Boolean            @default(true)
  privacyNoticeAcceptedAt  DateTime?
  linkedPersonnelId        String?            @unique
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  linkedPersonnel          Personnel?         @relation(fields: [linkedPersonnelId], references: [id], onDelete: SetNull)
  applications             HrJobApplication[]

  @@unique([foreignIdentityType, foreignIdentityNumber])
  @@index([lastName, firstName])
  @@index([mobile])
  @@map("hr_candidates")
}

model HrJobApplication {
  id                                 String                         @id @default(cuid())
  candidateId                        String
  positionId                         String
  stage                              HrApplicationStage             @default(RECEIVED)
  outcome                            HrApplicationOutcome?
  outcomeReason                      String?
  currentRevisionNumber              Int                            @default(0)
  identityClearance                  HrClearanceStatus              @default(NOT_STARTED)
  collateralClearance                HrClearanceStatus              @default(NOT_STARTED)
  contractClearance                  HrClearanceStatus              @default(NOT_STARTED)
  compensationClearance              HrClearanceStatus              @default(NOT_STARTED)
  acceptedOfferAt                    DateTime?
  convertedAt                        DateTime?
  scheduledStartDate                 DateTime?
  activatedAt                        DateTime?
  postalVerificationDeferred         Boolean                        @default(true)
  assessmentCompletedBy              String?
  assessmentCompletedAt              DateTime?
  assessmentReviewRequired           Boolean                        @default(false)
  assessmentReviewAcknowledgedBy     String?
  assessmentReviewAcknowledgedAt     DateTime?
  assessmentDecision                 HrAssessmentDecision?
  assessmentDecisionBy               String?
  assessmentDecisionAt               DateTime?
  assessmentDecisionReason           String?
  assessmentRepeatDueAt              DateTime?
  disposition                        HrApplicationDisposition?
  dispositionReason                  String?
  dispositionBy                      String?
  dispositionAt                      DateTime?
  preIdentityRequirementsFinalizedBy String?
  preIdentityRequirementsFinalizedAt DateTime?
  preIdentityManagementApprovedBy    String?
  preIdentityManagementApprovedAt    DateTime?
  preIdentityManagementApprovalNote  String?
  preIdentityReleasedBy              String?
  preIdentityReleasedAt              DateTime?
  preIdentityGrandfatheredAt         DateTime?
  preClosureStage                    HrApplicationStage?
  createdBy                          String
  createdAt                          DateTime                       @default(now())
  updatedAt                          DateTime                       @updatedAt
  candidate                          HrCandidate                    @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  position                           HrPosition                     @relation(fields: [positionId], references: [id], onDelete: Restrict)
  employmentRelationship             HrEmploymentRelationship?
  invitations                        HrCandidateInvitation[]
  formRevisions                      HrApplicationFormRevision[]
  documents                          HrHiringDocument[]
  identityChecks                     HrIdentityCheck[]
  collateralItems                    HrCollateralItem[]
  compensationSnapshots              HrCompensationSnapshot[]
  contracts                          HrEmploymentContractDocument[]
  insuranceEnrollment                HrInsuranceEnrollment?
  payrollParticipation               HrPayrollParticipation?
  onboardingTasks                    HrOnboardingTask[]
  audits                             HrHiringAudit[]
  assessments                        HrCandidateAssessment[]
  preIdentityChecklistItems          HrPreIdentityChecklistItem[]
  hiringDecisions                    HrApplicationDecision[]
  reopenings                         HrApplicationReopening[]
  collateralRequirements             HrCollateralRequirement[]
  collateralTemplateId               String?
  collateralTemplate                 HrCollateralChecklistTemplate? @relation(fields: [collateralTemplateId], references: [id], onDelete: SetNull)

  @@index([stage, outcome, updatedAt])
  @@index([candidateId, createdAt])
  @@index([positionId, stage])
  @@map("hr_job_applications")
}

model HrCandidateInvitation {
  id                    String           @id @default(cuid())
  applicationId         String
  mobileSnapshot        String
  otpHash               String
  otpCiphertext         String?
  expiresAt             DateTime
  revokedAt             DateTime?
  lastVerifiedAt        DateTime?
  verificationCount     Int              @default(0)
  overlapExpiresAt      DateTime?
  providerMessageId     String?
  providerDeliveryState String?
  providerDeliveryAt    DateTime?
  providerLastCheckedAt DateTime?
  accessConfirmedAt     DateTime?
  createdBy             String
  createdAt             DateTime         @default(now())
  application           HrJobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([mobileSnapshot, otpHash])
  @@index([applicationId, expiresAt])
  @@index([mobileSnapshot, expiresAt, revokedAt])
  @@map("hr_candidate_invitations")
}

model HrRecruitmentChecklistTemplate {
  id        String                               @id @default(cuid())
  name      String
  version   Int
  scopeType String                               @default("JOB")
  scopeId   String?
  isActive  Boolean                              @default(true)
  createdBy String
  createdAt DateTime                             @default(now())
  items     HrRecruitmentChecklistTemplateItem[]

  @@unique([name, version])
  @@index([scopeType, scopeId, isActive])
  @@map("hr_recruitment_checklist_templates")
}

model HrRecruitmentChecklistTemplateItem {
  id               String                         @id @default(cuid())
  templateId       String
  title            String
  instructions     String?
  evidencePolicy   HrChecklistEvidencePolicy      @default(NOTE_REQUIRED)
  sortOrder        Int                            @default(0)
  template         HrRecruitmentChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  applicationItems HrPreIdentityChecklistItem[]

  @@index([templateId, sortOrder])
  @@map("hr_recruitment_checklist_template_items")
}

model HrPreIdentityChecklistItem {
  id                         String                              @id @default(cuid())
  applicationId              String
  templateItemId             String?
  requirementKey             String
  attempt                    Int                                 @default(1)
  title                      String
  instructions               String?
  status                     HrChecklistItemStatus               @default(PENDING)
  evidencePolicy             HrChecklistEvidencePolicy           @default(NOTE_REQUIRED)
  dueAt                      DateTime?
  overdueNotifiedAt          DateTime?
  resultExplanation          String?
  resultSource               String?
  resultDate                 DateTime?
  managementResolution       String?
  managementResolutionReason String?
  storageName                String?
  originalName               String?
  mimeType                   String?
  size                       Int?
  sha256                     String?
  malwareScanStatus          String?
  recordedBy                 String?
  recordedAt                 DateTime?
  createdBy                  String
  createdAt                  DateTime                            @default(now())
  updatedAt                  DateTime                            @updatedAt
  application                HrJobApplication                    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  templateItem               HrRecruitmentChecklistTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  events                     HrPreIdentityChecklistEvent[]

  @@unique([applicationId, requirementKey, attempt])
  @@index([applicationId, status, dueAt])
  @@map("hr_pre_identity_checklist_items")
}

model HrPreIdentityChecklistEvent {
  id           String                     @id @default(cuid())
  itemId       String
  eventType    String
  snapshotJson Json
  actorUserId  String
  reason       String?
  createdAt    DateTime                   @default(now())
  item         HrPreIdentityChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@map("hr_pre_identity_checklist_events")
}

model HrApplicationDecision {
  id            String                  @id @default(cuid())
  applicationId String
  kind          HrHiringDecisionKind
  outcome       HrHiringDecisionOutcome
  explanation   String?
  changeReason  String?
  version       Int
  decidedBy     String
  decidedAt     DateTime                @default(now())
  application   HrJobApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, kind, version])
  @@index([applicationId, kind, decidedAt])
  @@map("hr_application_decisions")
}

model HrApplicationReopening {
  id                     String            @id @default(cuid())
  applicationId          String
  status                 HrReopeningStatus
  companyAuthorizedBy    String?
  companyAuthorizedAt    DateTime?
  companyReason          String?
  hrExecutedBy           String?
  hrExecutedAt           DateTime?
  hrReason               String?
  candidateConsentMethod String?
  candidateConsentedAt   DateTime?
  candidateConsentNote   String?
  blockedReason          String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  application            HrJobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, status, createdAt])
  @@map("hr_application_reopenings")
}

model HrCollateralRequirement {
  id                   String           @id @default(cuid())
  applicationId        String
  version              Int
  type                 String
  amountRials          Decimal?         @db.Decimal(18, 0)
  obligation           String?
  dueTiming            String?
  candidateExplanation String
  status               String           @default("ACTIVE")
  proposedBy           String
  proposedAt           DateTime         @default(now())
  supersedesId         String?
  application          HrJobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, version])
  @@index([applicationId, status])
  @@map("hr_collateral_requirements")
}

model HrCandidateAccessThrottle {
  id              String    @id @default(cuid())
  subjectKind     String
  subjectHash     String
  failedAttempts  Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  lastAttemptAt   DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([subjectKind, subjectHash])
  @@index([blockedUntil])
  @@map("hr_candidate_access_throttles")
}

model HrCandidateAccessAttempt {
  id            String   @id @default(cuid())
  mobileHash    String
  ipHash        String
  invitationId  String?
  applicationId String?
  outcome       String
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([mobileHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([applicationId, createdAt])
  @@map("hr_candidate_access_attempts")
}

model HrApplicationFormRevision {
  id                           String               @id @default(cuid())
  applicationId                String
  revisionNumber               Int
  status                       HrFormRevisionStatus @default(DRAFT)
  dataJson                     Json
  correctionFieldsJson         Json?
  correctionDetailsJson        Json?
  correctionReason             String?
  correctionNotificationStatus String?
  correctionNotificationError  String?
  correctionNotifiedAt         DateTime?
  correctionInvitationId       String?
  declarationAccepted          Boolean              @default(false)
  declarationFullName          String?
  submittedAt                  DateTime?
  submittedIp                  String?
  submittedUserAgent           String?
  returnedAt                   DateTime?
  returnedBy                   String?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  application                  HrJobApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, revisionNumber])
  @@index([applicationId, status])
  @@map("hr_application_form_revisions")
}

model HrHiringAuthority {
  id        String                @id @default(cuid())
  userId    String
  authority HrHiringAuthorityType
  isActive  Boolean               @default(true)
  expiresAt DateTime?
  createdBy String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([userId, authority])
  @@index([authority, isActive, expiresAt])
  @@map("hr_hiring_authorities")
}

model HrHiringAuthorityAudit {
  id          String   @id @default(cuid())
  authorityId String
  actorUserId String
  eventType   String
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  @@index([authorityId, createdAt])
  @@map("hr_hiring_authority_audits")
}

model HrHiringDocument {
  id                String             @id @default(cuid())
  applicationId     String
  category          String
  side              String?
  version           Int
  status            HrEvidenceStatus   @default(RECEIVED)
  inspectionSource  HrInspectionSource
  storageName       String
  originalName      String
  mimeType          String
  size              Int
  sha256            String
  malwareScanStatus String
  note              String?
  uploadedBy        String
  verifiedBy        String?
  verifiedAt        DateTime?
  createdAt         DateTime           @default(now())
  application       HrJobApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, category, side, version])
  @@index([applicationId, category, status])
  @@map("hr_hiring_documents")
}

model HrIdentityCheck {
  id            String           @id @default(cuid())
  applicationId String
  fieldKey      String
  status        HrEvidenceStatus
  note          String?
  reviewedBy    String
  reviewedAt    DateTime         @default(now())
  application   HrJobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, fieldKey])
  @@index([applicationId, status])
  @@map("hr_identity_checks")
}

model HrCollateralItem {
  id                              String                             @id @default(cuid())
  applicationId                   String
  type                            String
  required                        Boolean                            @default(true)
  amountRials                     Decimal?                           @db.Decimal(18, 0)
  identifier                      String?
  issuerOrGuarantor               String?
  receivedAt                      DateTime?
  custodyLocation                 String?
  status                          HrEvidenceStatus                   @default(MISSING)
  version                         Int                                @default(1)
  storageName                     String?
  originalName                    String?
  mimeType                        String?
  size                            Int?
  sha256                          String?
  malwareScanStatus               String?
  note                            String?
  coordinationReason              String?
  recordedBy                      String
  approvedBy                      String?
  approvedAt                      DateTime?
  returnedAt                      DateTime?
  returnedTo                      String?
  returnedBy                      String?
  returnEvidenceNote              String?
  returnEvidenceStorageName       String?
  returnEvidenceOriginalName      String?
  returnEvidenceMimeType          String?
  returnEvidenceSize              Int?
  returnEvidenceSha256            String?
  returnEvidenceMalwareScanStatus String?
  returnConfirmedBy               String?
  returnConfirmedAt               DateTime?
  createdAt                       DateTime                           @default(now())
  updatedAt                       DateTime                           @updatedAt
  application                     HrJobApplication                   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  templateItemId                  String?
  supersedesItemId                String?                            @unique
  templateItem                    HrCollateralChecklistTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  supersedesItem                  HrCollateralItem?                  @relation("HrCollateralReplacement", fields: [supersedesItemId], references: [id], onDelete: SetNull)
  supersededBy                    HrCollateralItem?                  @relation("HrCollateralReplacement")

  @@index([applicationId, status])
  @@map("hr_collateral_items")
}

model HrCollateralChecklistTemplate {
  id           String                              @id @default(cuid())
  name         String
  version      Int
  scopeType    String                              @default("GLOBAL")
  scopeId      String?
  isActive     Boolean                             @default(true)
  createdBy    String
  createdAt    DateTime                            @default(now())
  items        HrCollateralChecklistTemplateItem[]
  applications HrJobApplication[]

  @@unique([name, version])
  @@index([scopeType, scopeId, isActive])
  @@map("hr_collateral_checklist_templates")
}

model HrCollateralChecklistTemplateItem {
  id                 String                        @id @default(cuid())
  templateId         String
  type               String
  label              String
  required           Boolean                       @default(true)
  defaultAmountRials Decimal?                      @db.Decimal(18, 0)
  sortOrder          Int                           @default(0)
  template           HrCollateralChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  collateralItems    HrCollateralItem[]

  @@index([templateId, sortOrder])
  @@map("hr_collateral_checklist_template_items")
}

model HrCandidateAssessment {
  id                     String           @id @default(cuid())
  applicationId          String
  assessmentType         HrAssessmentType
  resultJson             Json
  storageName            String?
  originalName           String?
  mimeType               String?
  size                   Int?
  sha256                 String?
  malwareScanStatus      String?
  recordedBy             String
  recordedAt             DateTime         @default(now())
  version                Int              @default(1)
  status                 String           @default("ACTIVE")
  supersedesAssessmentId String?
  voidedBy               String?
  voidedAt               DateTime?
  voidReason             String?
  application            HrJobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, assessmentType, version])
  @@index([applicationId, assessmentType, recordedAt])
  @@map("hr_candidate_assessments")
}

model HrCompensationSnapshot {
  id                              String           @id @default(cuid())
  applicationId                   String
  version                         Int
  currency                        String           @default("IRR")
  componentsJson                  Json
  totalRials                      Decimal          @db.Decimal(18, 0)
  proposedBy                      String
  preparedBy                      String?
