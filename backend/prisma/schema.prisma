model GuardDriverQueueTurn {
  id                    String                        @id @default(cuid())
  driverSource          GuardDriverSource
  status                GuardDriverQueueTurnStatus    @default(WAITING_AT_GATE)
  internalDriverId      String?
  externalDriverId      String?
  companyVehicleId      String?
  externalVehicleId     String?
  assignmentId          String?
  admittedAt            DateTime                      @default(now())
  admittedBy            String
  snapshotSchemaVersion Int                           @default(1)
  admissionSnapshot     Json
  integrityHash         String                        @unique
  availableAt           DateTime?
  availableBy           String?
  loadingId             String?
  reservedAt            DateTime?
  reservedBy            String?
  finalizedAt           DateTime?
  finalizedBy           String?
  exitedAt              DateTime?
  exitedBy              String?
  closedAt              DateTime?
  closedBy              String?
  closureReason         String?
  voidedAt              DateTime?
  voidedBy              String?
  voidReason            String?
  replacementTurnId     String?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  internalDriver        InternalDriverProfile?        @relation(fields: [internalDriverId], references: [id], onDelete: Restrict)
  externalDriver        ExternalDriver?               @relation(fields: [externalDriverId], references: [id], onDelete: Restrict)
  companyVehicle        CompanyVehicle?               @relation(fields: [companyVehicleId], references: [id], onDelete: Restrict)
  externalVehicle       ExternalVehicle?              @relation(fields: [externalVehicleId], references: [id], onDelete: Restrict)
  assignment            DriverVehicleAssignment?      @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  loading               LogisticsLoading?             @relation(fields: [loadingId], references: [id], onDelete: Restrict)
  replacementTurn       GuardDriverQueueTurn?         @relation("GuardQueueReplacement", fields: [replacementTurnId], references: [id], onDelete: Restrict)
  replacedTurns         GuardDriverQueueTurn[]        @relation("GuardQueueReplacement")
  events                GuardDriverQueueEvent[]
  allocationDrafts      LogisticsAllocationDraft[]
  allocationRevisions   LogisticsAllocationRevision[]
  physicalExit          GuardPhysicalExit?
  manualOutageExit      ManualOutageExit?

  @@index([status, admittedAt])
  @@index([internalDriverId, status])
  @@index([externalDriverId, status])
  @@index([companyVehicleId, status])
  @@index([externalVehicleId, status])
  @@index([loadingId])
  @@map("guard_driver_queue_turns")
}

