# Public domain
DOMAIN=erp.example.com
FRONTEND_URL=https://erp.example.com
PUBLIC_APP_URL=https://erp.example.com
NEXT_PUBLIC_API_URL=/api

# Public price inquiry app
INQUIRY_DOMAIN=inquiry.example.com
INQUIRY_DATABASE_URL=file:/data/inquiry.db
APP_VERSION=1.0.0
APP_COMMIT=replace-with-deployed-git-commit
INQUIRY_ADMIN_EMAIL=admin@sabalan.local
INQUIRY_ADMIN_PASSWORD=REPLACE_WITH_STRONG_INQUIRY_ADMIN_PASSWORD
INQUIRY_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS

# Database
POSTGRES_DB=sabalanerp
POSTGRES_USER=sabalanerp
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
BACKEND_DB_CONNECTION_LIMIT=10
BACKEND_DB_POOL_TIMEOUT_SECONDS=10

# Zero-data-loss deployment control. The remote mount must be independent from
# this production host. The secret directory contains files named
# local-rollback-key (32+ random characters, mode 0600) and the non-secret
# remote-recovery-public.pem. The matching private key must remain off-server.
DEPLOYMENT_SECRET_DIR=./deploy/secrets
DEPLOYMENT_REMOTE_MOUNT_HOST=/mnt/sabalanerp-recovery
DEPLOYMENT_REPORT_DIR_HOST=./reports/deploy
DEPLOYMENT_CHECKPOINT_TIMEOUT_SECONDS=3600
DEPLOYMENT_OWNER=production-deployer
DEPLOYMENT_BACKEND_IMAGE_REPOSITORY=sabalanerp-backend
DEPLOYMENT_FRONTEND_IMAGE_REPOSITORY=sabalanerp-frontend
DEPLOYMENT_INQUIRY_IMAGE_REPOSITORY=sabalanerp-inquiry

# Auth
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS
WEB_PUSH_VAPID_SUBJECT=mailto:support@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
WEB_PUSH_VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY

# SMS provider
SMS_IR_API_KEY=REPLACE_WITH_SMS_API_KEY
SMS_IR_API_URL=https://api.sms.ir/v1
SMS_IR_TEMPLATE_ID=135816
SMS_IR_CONTRACT_CONFIRM_TEMPLATE_ID=385075
SMS_IR_HIRING_INVITATION_TEMPLATE_ID=REPLACE_WITH_HIRING_TEMPLATE_ID
SMS_IR_HIRING_INVITATION_TEMPLATE_PARAMETERS=Code
SMS_IR_HIRING_CORRECTION_TEMPLATE_ID=763918
SMS_IR_HIRING_OFFER_TEMPLATE_ID=894291
SMS_IR_DISPATCH_CONFIRM_OTP_TEMPLATE_ID=173656
SMS_IR_DISPATCH_EXIT_TEMPLATE_ID=153829
SMS_IR_DISPATCH_EXIT_MANUAL_RETRY_TEMPLATE_ID=3429496
SMS_IR_ENVIRONMENT=production
SMS_IR_TIMEOUT_MS=30000
SMS_IR_DNS_SERVERS=178.22.122.100,185.51.200.2

# Dispatch biometric rollout (keep false until counsel and connector readiness).
BIOMETRIC_TEMPLATE_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
DISPATCH_CONFIRMATION_OTP_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
BIOMETRIC_LEGAL_READY=false
BIOMETRIC_CONNECTOR_MODE=unconfigured
BIOMETRIC_WORKSTATIONS_JSON={}

# HR hiring uploads are scanned by the private ClamAV service in docker-compose.prod.yml.
# No antivirus host installation or environment override is required.

# HR redesign stays in compatibility mode until every Cutover gate has passed.
# Enabling it without a mounted revision-bound acceptance file blocks backend startup.
HR_REDESIGN_CUTOVER_ENABLED=false
HR_REDESIGN_CUTOVER_ACCEPTANCE_PATH=
HR_REDESIGN_CUTOVER_REVISION=

# Contract confirmation
CONTRACT_CONFIRM_LINK_TTL_DAYS=60
CONTRACT_CONFIRM_OTP_TTL_MINUTES=10
CONTRACT_CONFIRM_MAX_ATTEMPTS=5
CONTRACT_CONFIRM_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_CODE_EXPIRY_MINUTES=10
# Emergency safety switch. Set true to keep contract reads/PDFs available while
# rejecting all product-graph create/edit/migration writes.
CONTRACT_PRODUCT_GRAPH_READ_ONLY=false
