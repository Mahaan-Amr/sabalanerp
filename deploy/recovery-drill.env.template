# Install only on the independent recovery-drill host as
# /etc/sabalanerp/recovery-drill.env with mode 0600.
SABALANERP_DRILL_APP_ROOT=/opt/sabalanerp
NODE_ENV=test
DEPLOYMENT_DRILL_ISOLATED=true
DATABASE_URL=postgresql://drill-user:REPLACE@drill-postgres:5432/sabalanerp_drill
PRODUCTION_DATABASE_URL=postgresql://production-identity-only.invalid/sabalanerp
DEPLOYMENT_DRILL_DATABASE_MARKER=REPLACE_WITH_A_UNIQUE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
DEPLOYMENT_REMOTE_MOUNT=/mnt/sabalanerp-recovery
DEPLOYMENT_REMOTE_RECOVERY_PRIVATE_KEY_FILE=/etc/sabalanerp/remote-recovery-private.pem
DEPLOYMENT_REPORT_DIR=/var/lib/sabalanerp-drill/reports
