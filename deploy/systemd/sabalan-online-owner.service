[Unit]
Description=Sabalan original online release owner
RefuseManualStop=yes
StopWhenUnneeded=no

[Service]
Type=notify
NotifyAccess=main
User=root
UMask=0077
Restart=no
KillMode=mixed
KillSignal=SIGTERM
SendSIGHUP=no
SendSIGKILL=no
TimeoutStartSec=infinity
TimeoutStopSec=infinity
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/sabalan-online-owner/online-owner-service.py --serve /etc/sabalan/online/original-owner.json
ExecStop=/usr/bin/python3 -I -B /usr/local/lib/sabalan-online-owner/online-owner-service.py --await-original-quiescence /etc/sabalan/online/original-owner.json
