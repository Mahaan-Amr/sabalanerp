{
  "name": "sabalanerp",
  "version": "1.0.0",
  "description": "ERP system with Next.js frontend and Express.js backend",
  "main": "index.js",
  "scripts": {
    "duty:baseline": "node scripts/run-duty-baseline-local.mjs",
    "duty:reconcile:sales-contract-corrections": "node scripts/run-sales-contract-correction-duty-reconciliation-local.mjs",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:contract-product-graph && npm run build:frontend && npm run build:backend",
    "build:contract-product-graph": "npm --prefix packages/contract-product-graph run build",
    "test:contract-product-graph": "npm --prefix packages/contract-product-graph test",
    "typecheck:contract-product-graph": "npm --prefix packages/contract-product-graph run typecheck",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:frontend": "cd frontend && npm run start",
    "start:backend": "cd backend && npm run start",
    "install:all": "npm install && npm --prefix packages/contract-product-graph install && cd frontend && npm install && cd ../backend && npm install",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:local:up": "docker compose -f docker-compose.local.yml up --build -d --wait",
    "docker:local:down": "docker compose -f docker-compose.local.yml down",
    "docker:local:logs": "docker compose -f docker-compose.local.yml logs -f",
    "docker:local:ps": "docker compose -f docker-compose.local.yml ps",
    "docker:dev": "node scripts/start-docker-dev.mjs",
    "docker:dev:down": "docker compose -f docker-compose.local.yml -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.local.yml -f docker-compose.dev.yml logs -f",
    "docker:dev:ps": "docker compose -f docker-compose.local.yml -f docker-compose.dev.yml ps",
    "docker:verify": "node scripts/verify-local-docker.mjs",
    "prototype:hr-interview": "docker compose -f docker-compose.local.yml up -d --build frontend",
    "prototype:accounting-dashboard": "docker compose -f docker-compose.local.yml up -d --build frontend",
    "prototype:partner-management": "docker compose -f docker-compose.local.yml up -d --build frontend",
    "docker:prod:build": "docker compose --env-file deploy/.env.prod -f docker-compose.prod.yml build",
    "check:frontend-docker-workspace": "node deploy/scripts/check-frontend-docker-workspace.mjs",
    "docker:prod:up": "docker compose --env-file deploy/.env.prod -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose --env-file deploy/.env.prod -f docker-compose.prod.yml down",
    "docker:prod:migrate": "docker compose --env-file deploy/.env.prod -f docker-compose.prod.yml run --rm backend npx prisma migrate deploy",
    "db:create": "node setup-database.js",
    "db:migrate": "cd backend && npx prisma migrate dev",
    "db:generate": "cd backend && npx prisma generate",
    "db:studio": "cd backend && npx prisma studio",
    "sync:opc-products:dry": "cd backend && npm run sync:opc-products:dry",
    "sync:opc-products:apply": "cd backend && npm run sync:opc-products:apply",
    "setup": "npm run install:all && npm run docker:up && sleep 10 && npm run db:create && npm run db:migrate && npm run db:generate",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "setup:git-hooks": "node scripts/setup-git-hooks.mjs",
    "text:scan": "node scripts/text-corruption-inventory.mjs",
    "text:check": "npm run text:scan && node scripts/check-text-corruption.mjs",
    "architecture:check": "node scripts/check-database-client-ownership.mjs",
    "audit:hr-onboarding-retirement": "npm --prefix backend run audit:hr-onboarding-retirement",
    "design-system:report": "node scripts/design-system-adoption.mjs report",
    "design-system:baseline": "node scripts/design-system-adoption.mjs baseline",
    "design-system:check": "node scripts/design-system-adoption.mjs check --changed",
    "test:design-system-adoption": "node --test tests/design-system-adoption/design-system-adoption.spec.mjs",
    "test:design-system-foundation": "node --test tests/design-system-foundation/semantic-foundation.spec.mjs",
    "test:design-system:e2e": "node scripts/run-design-system-e2e.mjs",
    "test:design-system:e2e:infrastructure": "node --test tests/design-system-e2e-infrastructure/infrastructure.spec.mjs",
    "test:accounting-dispatch-documents:e2e:real": "npx tsx --test tests/accounting-dispatch-documents-real/qa-identities.test.ts && playwright test --config=playwright.accounting-dispatch-documents.config.ts",
    "test:support-notifications:e2e": "playwright test --config=playwright.support-notifications.config.ts",
    "test:hr-hiring:e2e": "node scripts/run-hr-hiring-e2e.mjs",
    "test:hr-hiring:e2e:docker": "docker compose -f docker-compose.e2e.yml up -d --wait && npm run test:hr-hiring:e2e:ci",
    "test:hr-hiring:e2e:ci": "playwright test --config=playwright.hr-hiring.config.ts",
    "test:hr-hiring:e2e:down": "docker compose -f docker-compose.e2e.yml down -v",
    "prototype:shipment-statement-reconciliation": "node scripts/prototypes/shipment-statement-reconciliation/tui.mjs",
    "test:dispatch-document-pdfs:docker": "node scripts/run-dispatch-document-pdf-qa.mjs"
  },
  "keywords": [
    "erp",
    "nextjs",
    "express",
    "typescript",
    "postgresql"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "concurrently": "^8.2.2",
    "pg": "^8.11.3"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
