+import { listCustomerWorkspaceAccounts, readCustomerWorkspace, recordCustomerAccountOperation, recordCustomerWorkspaceTreasury } from '../accountingCustomerWorkspace';
+import { listPostedTrialBalance } from '../accountingLedgerPrismaRepository';
+import { createTemporaryConcurrencyDatabase } from './shipmentStatementConcurrency/database';
+const sourceDatabaseUrl = process.env.ACCOUNTING_LEDGER_TEST_DATABASE_URL;
+
+test('customer workspace: exact balances, immutable history, refund limits and CRM-only accounts', { skip: !sourceDatabaseUrl, timeout: 240_000 }, async () => {
+  const temporary = await createTemporaryConcurrencyDatabase({ repositoryRoot: path.resolve(process.cwd(), '..'), sourceDatabaseUrl: sourceDatabaseUrl!, migrateEmptySchema: true });
+  const db = temporary.client();
+  try {
