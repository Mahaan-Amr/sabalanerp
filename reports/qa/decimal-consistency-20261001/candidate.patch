+}
+const precise = canonicalProductSavePricing({ materialBase: '100', cuttingCost: '0.4', totalAmount: '100.4' }, '0.2');
+const exactSlab = reconcileContractProductPricing({ productType: 'slab', originalTotalPrice: 100,
