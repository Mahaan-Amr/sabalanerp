+      note: 'مهلت ویرایش پایان یافت؛ تغییرات ذخیره‌شده برای بررسی حسابداری حفظ شد. ویرایش بعدی نیاز به تصمیم تازه مدیر دارد.',
+      policyVersion: 2, periodExpired: true, now });
+  });
+};
