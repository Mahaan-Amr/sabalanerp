+    await pending[8](10); await waitRequests(10); await count(9);
+    await pending[9](11); await count(11);
+    await page.setViewportSize({ width: 390, height: 844 });
+    await count(11);
+    await page.screenshot({ path: path.join(output, 'hook-lifecycle.png') });
